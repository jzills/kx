# Generated by tools/gen-demo-tapes for the github-dark palette. Do not edit.
# Regenerate with: go run ./tools/gen-demo-tapes

Set FontSize 16
Set Width 1200
Set Height 750
Set FontFamily "Ubuntu Mono"
Set Framerate 30
Set Theme {"background":"#0d1117","black":"#0d1117","blue":"#7d8590","brightBlack":"#7d8590","brightBlue":"#7d8590","brightCyan":"#7d8590","brightGreen":"#3fb950","brightMagenta":"#3fb950","brightRed":"#f85149","brightWhite":"#e6edf3","brightYellow":"#e3b341","cursor":"#3fb950","cyan":"#7d8590","foreground":"#e6edf3","green":"#3fb950","magenta":"#3fb950","red":"#f85149","white":"#e6edf3","yellow":"#e3b341"}

Env KX_THEME "github-dark"
Output site/static/demo/demo-github-dark.gif
Type "kx get pods"
Enter
Sleep 2.5s

Type "kx labels 2"
Enter
Sleep 2s

Type "kx logs 2 --tail=2"
Enter
Sleep 2.5s

Type "kx top"
Enter
Sleep 2.5s

Type "kx get deployments"
Enter
Sleep 2s

Type "kx tree 7"
Enter
Sleep 3s

Type "kx diag"
Enter
Sleep 4s
