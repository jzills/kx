# Generated by tools/gen-demo-tapes for the gruvbox palette. Do not edit.
# Regenerate with: go run ./tools/gen-demo-tapes

Env KX_THEME "gruvbox"
Output site/static/demo/demo-gruvbox.gif

Set FontSize 16
Set Width 1200
Set Height 750
Set FontFamily "Ubuntu Mono"
Set Framerate 30
Set Theme {"background":"#282828","black":"#282828","blue":"#928374","brightBlack":"#928374","brightBlue":"#928374","brightCyan":"#928374","brightGreen":"#fe8019","brightMagenta":"#fe8019","brightRed":"#fb4934","brightWhite":"#ebdbb2","brightYellow":"#fabd2f","cursor":"#fe8019","cyan":"#928374","foreground":"#ebdbb2","green":"#fe8019","magenta":"#fe8019","red":"#fb4934","white":"#ebdbb2","yellow":"#fabd2f"}

Type "kx get pods"
Enter
Sleep 2.5s

Type "kx labels 2"
Enter
Sleep 2s

Type "kx logs 2 --tail=2"
Enter
Sleep 2.5s

Type "kx top"
Enter
Sleep 2.5s

Type "kx get deployments"
Enter
Sleep 2s

Type "kx tree 7"
Enter
Sleep 3s

Type "kx diag"
Enter
Sleep 4s
