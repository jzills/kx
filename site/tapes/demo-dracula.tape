# Generated by tools/gen-demo-tapes for the dracula palette. Do not edit.
# Regenerate with: go run ./tools/gen-demo-tapes

Env KX_THEME "dracula"
Output site/static/demo/demo-dracula.gif

Set FontSize 16
Set Width 1200
Set Height 750
Set FontFamily "Ubuntu Mono"
Set Framerate 30
Set Theme {"background":"#282a36","black":"#282a36","blue":"#6272a4","brightBlack":"#6272a4","brightBlue":"#6272a4","brightCyan":"#6272a4","brightGreen":"#bd93f9","brightMagenta":"#bd93f9","brightRed":"#ff5555","brightWhite":"#f8f8f2","brightYellow":"#f1fa8c","cursor":"#bd93f9","cyan":"#6272a4","foreground":"#f8f8f2","green":"#bd93f9","magenta":"#bd93f9","red":"#ff5555","white":"#f8f8f2","yellow":"#f1fa8c"}

Type "kx get pods"
Enter
Sleep 2.5s

Type "kx labels 2"
Enter
Sleep 2s

Type "kx logs 2 --tail=2"
Enter
Sleep 2.5s

Type "kx top"
Enter
Sleep 2.5s

Type "kx get deployments"
Enter
Sleep 2s

Type "kx tree 7"
Enter
Sleep 3s

Type "kx diag"
Enter
Sleep 4s
