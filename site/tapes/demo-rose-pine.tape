# Generated by tools/gen-demo-tapes for the rose-pine palette. Do not edit.
# Regenerate with: go run ./tools/gen-demo-tapes

Set FontSize 14
Set Width 1024
Set Height 700
Set FontFamily "Ubuntu Mono"
Set Framerate 30
Set Theme {"background":"#191724","black":"#191724","blue":"#908caa","brightBlack":"#908caa","brightBlue":"#908caa","brightCyan":"#908caa","brightGreen":"#c4a7e7","brightMagenta":"#c4a7e7","brightRed":"#eb6f92","brightWhite":"#e0def4","brightYellow":"#f6c177","cursor":"#c4a7e7","cyan":"#908caa","foreground":"#e0def4","green":"#c4a7e7","magenta":"#c4a7e7","red":"#eb6f92","white":"#e0def4","yellow":"#f6c177"}

Env KX_THEME "rose-pine"
Output site/static/demo/demo-rose-pine.gif
Type "kx get pods"
Enter
Sleep 2.5s

Type "kx labels 2"
Enter
Sleep 2s

Type "kx logs 2 --tail=2"
Enter
Sleep 2.5s

Type "kx top"
Enter
Sleep 2.5s

Type "kx get deployments"
Enter
Sleep 2s

