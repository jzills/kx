# Generated by tools/gen-demo-tapes for the solarized-dark palette. Do not edit.
# Regenerate with: go run ./tools/gen-demo-tapes

Set FontSize 16
Set Width 1200
Set Height 750
Set FontFamily "Ubuntu Mono"
Set Framerate 30
Set Theme {"background":"#002b36","black":"#002b36","blue":"#849496","brightBlack":"#849496","brightBlue":"#849496","brightCyan":"#849496","brightGreen":"#268bd2","brightMagenta":"#268bd2","brightRed":"#dc322f","brightWhite":"#93a1a1","brightYellow":"#b58900","cursor":"#268bd2","cyan":"#849496","foreground":"#93a1a1","green":"#268bd2","magenta":"#268bd2","red":"#dc322f","white":"#93a1a1","yellow":"#b58900"}

Env KX_THEME "solarized-dark"
Output site/static/demo/demo-solarized-dark.gif
Type "kx get pods"
Enter
Sleep 2.5s

Type "kx labels 2"
Enter
Sleep 2s

Type "kx logs 2 --tail=2"
Enter
Sleep 2.5s

Type "kx top"
Enter
Sleep 2.5s

Type "kx get deployments"
Enter
Sleep 2s

Type "kx tree 7"
Enter
Sleep 3s

Type "kx diag"
Enter
Sleep 4s
