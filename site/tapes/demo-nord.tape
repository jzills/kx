# Generated by tools/gen-demo-tapes for the nord palette. Do not edit.
# Regenerate with: go run ./tools/gen-demo-tapes

Env KX_THEME "nord"
Output site/static/demo/demo-nord.gif

Set FontSize 16
Set Width 1200
Set Height 750
Set FontFamily "Ubuntu Mono"
Set Framerate 30
Set Theme {"background":"#2e3440","black":"#2e3440","blue":"#7b88a1","brightBlack":"#7b88a1","brightBlue":"#7b88a1","brightCyan":"#7b88a1","brightGreen":"#88c0d0","brightMagenta":"#88c0d0","brightRed":"#bf616a","brightWhite":"#d8dee9","brightYellow":"#ebcb8b","cursor":"#88c0d0","cyan":"#7b88a1","foreground":"#d8dee9","green":"#88c0d0","magenta":"#88c0d0","red":"#bf616a","white":"#d8dee9","yellow":"#ebcb8b"}

Type "kx get pods"
Enter
Sleep 2.5s

Type "kx labels 2"
Enter
Sleep 2s

Type "kx logs 2 --tail=2"
Enter
Sleep 2.5s

Type "kx top"
Enter
Sleep 2.5s

Type "kx get deployments"
Enter
Sleep 2s

Type "kx tree 7"
Enter
Sleep 3s

Type "kx diag"
Enter
Sleep 4s
