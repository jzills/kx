# Generated by tools/gen-demo-tapes for the mono palette. Do not edit.
# Regenerate with: go run ./tools/gen-demo-tapes

Set FontSize 14
Set Width 1024
Set Height 700
Set FontFamily "Ubuntu Mono"
Set Framerate 30
Set Theme {"background":"#101010","black":"#101010","blue":"#8a8a8a","brightBlack":"#8a8a8a","brightBlue":"#8a8a8a","brightCyan":"#8a8a8a","brightGreen":"#ffffff","brightMagenta":"#ffffff","brightRed":"#ffffff","brightWhite":"#e6e6e6","brightYellow":"#c0c0c0","cursor":"#ffffff","cyan":"#8a8a8a","foreground":"#e6e6e6","green":"#ffffff","magenta":"#ffffff","red":"#ffffff","white":"#e6e6e6","yellow":"#c0c0c0"}

Env KX_THEME "mono"
Output site/static/demo/demo-mono.gif
Type "kx get pods"
Enter
Sleep 2.5s

Type "kx labels 2"
Enter
Sleep 2s

Type "kx logs 2 --tail=2"
Enter
Sleep 2.5s

Type "kx top"
Enter
Sleep 2.5s

Type "kx get deployments"
Enter
Sleep 2s

Type "kx tree 7"
Enter
Sleep 3s

Type "kx diag"
Enter
Sleep 4s
