# Generated by tools/gen-demo-tapes for the light palette. Do not edit.
# Regenerate with: go run ./tools/gen-demo-tapes

Env KX_THEME "light"
Output site/static/demo/demo-light.gif

Set FontSize 16
Set Width 1200
Set Height 750
Set FontFamily "Ubuntu Mono"
Set Framerate 30
Set Theme {"background":"#ffffff","black":"#ffffff","blue":"#57606a","brightBlack":"#57606a","brightBlue":"#57606a","brightCyan":"#57606a","brightGreen":"#1a7f37","brightMagenta":"#1a7f37","brightRed":"#cf222e","brightWhite":"#24292f","brightYellow":"#9a6700","cursor":"#1a7f37","cyan":"#57606a","foreground":"#24292f","green":"#1a7f37","magenta":"#1a7f37","red":"#cf222e","white":"#24292f","yellow":"#9a6700"}

Type "kx get pods"
Enter
Sleep 2.5s

Type "kx labels 2"
Enter
Sleep 2s

Type "kx logs 2 --tail=2"
Enter
Sleep 2.5s

Type "kx top"
Enter
Sleep 2.5s

Type "kx get deployments"
Enter
Sleep 2s

Type "kx tree 7"
Enter
Sleep 3s

Type "kx diag"
Enter
Sleep 4s
