# Generated by tools/gen-demo-tapes for the tokyo-night palette. Do not edit.
# Regenerate with: go run ./tools/gen-demo-tapes

Env KX_THEME "tokyo-night"
Output site/static/demo/demo-tokyo-night.gif

Set FontSize 16
Set Width 1200
Set Height 750
Set FontFamily "Ubuntu Mono"
Set Framerate 30
Set Theme {"background":"#1a1b26","black":"#1a1b26","blue":"#787f9c","brightBlack":"#787f9c","brightBlue":"#787f9c","brightCyan":"#787f9c","brightGreen":"#7aa2f7","brightMagenta":"#7aa2f7","brightRed":"#f7768e","brightWhite":"#c0caf5","brightYellow":"#e0af68","cursor":"#7aa2f7","cyan":"#787f9c","foreground":"#c0caf5","green":"#7aa2f7","magenta":"#7aa2f7","red":"#f7768e","white":"#c0caf5","yellow":"#e0af68"}

Type "kx get pods"
Enter
Sleep 2.5s

Type "kx labels 2"
Enter
Sleep 2s

Type "kx logs 2 --tail=2"
Enter
Sleep 2.5s

Type "kx top"
Enter
Sleep 2.5s

Type "kx get deployments"
Enter
Sleep 2s

Type "kx tree 7"
Enter
Sleep 3s

Type "kx diag"
Enter
Sleep 4s
