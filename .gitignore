# Anchored. Unanchored, "docs/" matches a directory of that name at any depth,
# which silently swallowed site/content/docs — the published documentation —
# with nothing failing to say so. This entry is for the design notes at the
# repository root and only those.
/docs/
.superpowers/
.claude/
build/
dist/

# Written by `go test -coverprofile`, which is what CI runs and what you run
# locally to see where you stand against the floor in pr.yml.
coverage.out

# Leftovers from the Python implementation. Nothing in the repo creates these
# any more; they are ignored so a stale local venv can't be committed.
.venv/
.coverage
