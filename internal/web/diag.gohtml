{{define "report"}}
<div class="block">
  <p class="label">Summary</p>
  <div class="findings">
    {{if .Findings}}
      {{range .Findings}}
      <div class="finding-row">
        <span class="icon {{severityClass .Severity}}">{{severityIcon .Severity}}</span>
        <span>{{.Summary}}{{with age .At}}<span class="dim"> · {{.}}</span>{{end}}</span>
      </div>
      {{end}}
    {{else}}
      <p class="dim">No issues detected</p>
    {{end}}
  </div>
</div>

{{if .Pods}}
<div class="block">
  <p class="label">Pods</p>
  <div class="table-wrap">
    <table>
      <thead><tr>
        <th style="width:20%">POD</th><th style="width:9%">PHASE</th><th style="width:7%">READY</th><th class="num" style="width:8%">RESTARTS</th>
        <th style="width:14%">CONTAINER</th><th style="width:9%">STATE</th><th style="width:13%">REASON</th><th style="width:10%">CPU</th><th style="width:10%">MEM</th>
      </tr></thead>
      <tbody>
      {{range $pod := .Pods}}
        {{if $pod.Containers}}
          {{range $i, $c := $pod.Containers}}
          <tr>
            <td>{{if eq $i 0}}{{$pod.Name}}{{end}}</td>
            <td class="{{statusClass $pod.Phase}}">{{if eq $i 0}}{{$pod.Phase}}{{end}}</td>
            <td>{{if eq $i 0}}{{ready $pod}}{{end}}</td>
            <td class="num">{{$c.RestartCount}}{{if $c.RestartCount}}{{with age $c.LastTerminatedAt}} <span class="dim">({{.}})</span>{{end}}{{end}}</td>
            <td>{{$c.Name}}</td>
            <td class="{{statusClass $c.State}}">{{$c.State}}</td>
            <td class="{{statusClass (reason $c)}}">{{reason $c}}</td>
            {{template "meter" cpuUsage $c}}
            {{template "meter" memoryUsage $c}}
          </tr>
          {{end}}
        {{else}}
          <tr>
            <td>{{$pod.Name}}</td>
            <td class="{{statusClass $pod.Phase}}">{{$pod.Phase}}</td>
            <td>{{ready $pod}}</td>
            <td class="num"></td><td></td><td></td><td></td>
            <td class="dim">—</td><td class="dim">—</td>
          </tr>
        {{end}}
      {{end}}
      </tbody>
    </table>
  </div>
</div>
{{end}}

{{$logs := false}}
{{range .Pods}}{{range .Containers}}{{if .LogLines}}{{$logs = true}}{{end}}{{end}}{{end}}
{{if $logs}}
<div class="block">
  <p class="label">Logs</p>
  {{range $pod := .Pods}}
    {{range $c := $pod.Containers}}
      {{if $c.LogLines}}
      <div>
        <p class="subhead">Pod/{{$pod.Name}} · container {{$c.Name}}{{if eq $c.LogSource "previous"}}{{with age $c.LastTerminatedAt}} · previous instance, {{.}}{{end}}{{end}}{{if not $c.LogFiltered}} · recent output{{end}}</p>
        <pre class="logblock">{{range $c.LogLines}}{{.}}
{{end}}</pre>
      </div>
      {{end}}
    {{end}}
  {{end}}
</div>
{{end}}

<div class="block">
  <p class="label">Warning events</p>
  {{if .WarningEvents}}
    <div>
    {{range .WarningEvents}}
      <div class="event">
        <p class="event-head">{{.Kind}}/{{.Name}} · <span class="{{statusClass .Reason}}">{{.Reason}}</span> ×{{.Count}}{{with age .LastTimestamp}} · {{.}}{{end}}</p>
        <p class="event-msg">{{.Message}}</p>
      </div>
    {{end}}
    </div>
  {{else}}
    <p class="dim">No warning events{{with window .Window}} in the {{.}}{{end}}</p>
  {{end}}
</div>
{{end}}

{{define "meter"}}
{{if .Known}}
<td><div class="meter"><span class="meter-track"><span class="meter-fill {{.Class}}" style="width:{{.Pct}}%"></span></span><span class="meter-value">{{.Pct}}%</span></div></td>
{{else}}
<td class="dim">—</td>
{{end}}
{{end}}

{{define "body"}}
{{if .Single}}
  {{$r := index .Reports 0}}
  <div class="banner">
    <span>{{$r.Kind}}/{{$r.Name}}</span>
    <span class="sep">·</span>
    {{/* Dropped whole for a cluster-scoped resource — a Node, a PV, a
         StorageClass — which has no namespace to name. The terminal header
         omits it for the same reason (render/diagnostic.go); leaving it here
         rendered an empty span between two separators, so the page said
         "Node/node-a · · healthy" where the terminal said the truth. */}}
    {{if $r.Namespace}}
      <span class="ns">{{$r.Namespace}}</span>
      <span class="sep">·</span>
    {{end}}
    <span class="verdict {{severityClass $r.Verdict}}">{{severityIcon $r.Verdict}} {{$r.Verdict}}</span>
  </div>
  {{template "report" $r}}
{{else}}
  <div class="block">
    {{if eq .Checked 0}}
      <p class="caption">Mixed · {{.Scope}} · {{.Checked}} checked</p>
    {{else}}
      <p class="caption">Mixed · {{.Scope}} · {{.Checked}} checked</p>
      <div class="grid-mount" data-kx-grid="diag" data-all-namespaces="{{.AllNamespaces}}"></div>
      <script type="application/json" id="kx-diag-data">{{diagRowsJSON .Reports}}</script>
      {{range $i, $r := .Reports}}<template id="diag-detail-{{$i}}">{{template "report" $r}}</template>{{end}}
      <footer>
        kx diag &lt;index&gt; for the same detail in your terminal
      </footer>
    {{end}}
  </div>
{{end}}
{{end}}
