{{define "body"}}
<div class="block">
  <p class="caption">{{.Scope}} · {{len .Images}} {{if eq (len .Images) 1}}image{{else}}images{{end}}</p>

  <p class="label">Images</p>
  <div class="grid-mount" data-kx-grid="scan-images"></div>
  <script type="application/json" id="kx-scan-images-data">{{scanImageRowsJSON .Images}}</script>

  <p class="label">Vulnerabilities</p>
  <div class="grid-mount" data-kx-grid="scan-findings"></div>
  <script type="application/json" id="kx-scan-findings-data">{{scanFindingRowsJSON .Images}}</script>
</div>
{{end}}
