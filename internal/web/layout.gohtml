{{define "layout"}}<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{.Title}}</title>
<link rel="icon" type="image/svg+xml" href="{{favicon .Styles}}">
<style>
{{tabulatorCSS}}
{{kxGridCSS}}
{{cssVars .Styles}}
{{stylesheet}}</style>
</head>
<body>
<div class="shell">
<header class="masthead">
  {{wordmark}}
  <div class="invocation"><b>{{.Invocation}}</b> · captured {{.Captured.Format "2006-01-02 15:04:05 MST"}}</div>
</header>
{{template "body" .}}
</div>
<script>{{tabulatorJS}}</script>
<script>{{kxGridJS}}</script>
</body>
</html>
{{end}}
