              "type": "boolean"
            },
            "checked": {
              "type": "integer"
            },
            "healthy": {
              "type": "integer"
            },
            "kind": {
              "type": "string"
            },
            "name": {
              "type": "string"
            },
            "namespace": {
              "type": "string"
            },
            "resources": {
              "items": {
                "additionalProperties": false,
                "properties": {
                  "findings": {
                    "items": {
                      "additionalProperties": false,
                      "properties": {
                        "at": {
                          "type": "string"
                        },
                        "severity": {
