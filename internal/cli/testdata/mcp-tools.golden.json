            "kind": {
              "description": "Resource type as kubectl spells it: pods, deploy, Deployment, a CRD's name. Required unless mark is given.",
              "type": "string"
            },
            "mark": {
              "description": "A kx mark (with or without the leading @) in place of kind, name and namespace. list_marks shows them.",
              "type": "string"
            },
            "name": {
              "description": "Resource name. Required unless mark is given.",
              "type": "string"
            },
            "namespace": {
              "description": "Namespace; defaults to the kubeconfig's current namespace. Omit for cluster-scoped kinds such as nodes.",
              "type": "string"
            }
          },
          "type": [
            "null",
            "object"
          ]
        }
      },
      "type": "object"
    },
    "outputSchema": {
      "additionalProperties": false,
      "properties": {
        "context": {
          "type": "string"
        },
        "diagnosis": {
          "additionalProperties": false,
          "properties": {
            "allNamespaces": {
              "type": "boolean"
            },
            "checked": {
              "type": "integer"
            },
            "healthy": {
              "type": "integer"
            },
            "kind": {
              "type": "string"
            },
            "name": {
              "type": "string"
            },
            "namespace": {
              "type": "string"
            },
            "resources": {
              "items": {
                "additionalProperties": false,
                "properties": {
                  "findings": {
                    "items": {
                      "additionalProperties": false,
                      "properties": {
                        "at": {
                          "type": "string"
                        },
                        "severity": {
                          "type": "string"
                        },
                        "since": {
                          "type": "string"
                        },
                        "summary": {
                          "type": "string"
                        }
                      },
                      "required": [
                        "severity",
                        "summary"
                      ],
                      "type": "object"
                    },
                    "type": [
                      "null",
                      "array"
                    ]
                  },
                  "index": {
                    "type": "integer"
                  },
                  "kind": {
                    "type": "string"
                  },
                  "mark": {
                    "type": "string"
                  },
                  "name": {
                    "type": "string"
                  },
                  "namespace": {
                    "type": "string"
                  },
                  "verdict": {
                    "type": "string"
                  }
                },
                "required": [
                  "kind",
                  "name",
                  "verdict",
                  "findings"
                ],
                "type": "object"
              },
              "type": [
                "null",
                "array"
              ]
            },
            "schemaVersion": {
              "type": "integer"
            },
            "window": {
              "type": "string"
            }
          },
          "required": [
            "schemaVersion",
            "checked",
            "healthy",
            "resources"
          ],
          "type": "object"
        }
      },
      "required": [
        "context",
        "diagnosis"
      ],
      "type": "object"
    }
