                      "array"
                    ]
                  },
                  "index": {
                    "type": "integer"
                  },
                  "kind": {
                    "type": "string"
                  },
                  "mark": {
                    "type": "string"
                  },
                  "name": {
                    "type": "string"
                  },
                  "namespace": {
                    "type": "string"
                  },
                  "verdict": {
                    "type": "string"
                  }
                },
                "required": [
                  "kind",
                  "name",
                  "verdict",
                  "findings"
                ],
                "type": "object"
              },
              "type": [
                "null",
                "array"
              ]
            },
            "schemaVersion": {
              "type": "integer"
            },
            "window": {
              "type": "string"
            }
          },
          "required": [
            "schemaVersion",
            "checked",
            "healthy",
            "resources"
          ],
          "type": "object"
        }
      },
      "required": [
        "context",
        "diagnosis"
      ],
      "type": "object"
    }
