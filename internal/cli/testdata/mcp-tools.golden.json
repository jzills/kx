[
  {
    "name": "diagnose",
    "annotations": {
      "idempotentHint": true,
      "readOnlyHint": true,
      "title": "Diagnose"
    },
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "allNamespaces": {
          "description": "Sweep every namespace when there is no target.",
          "type": "boolean"
        },
        "full": {
          "description": "Include healthy resources in a sweep's results.",
          "type": "boolean"
        },
        "namespace": {
          "description": "Namespace to sweep when there is no target; defaults to the current namespace.",
          "type": "string"
        },
        "since": {
          "description": "Ignore what finished longer ago than this — 30m, 24h, 7d. Ongoing problems are always reported. Defaults to kx's diag_max_age setting.",
          "type": "string"
        },
        "target": {
          "additionalProperties": false,
          "description": "One resource to diagnose. Omit to sweep a namespace.",
          "properties": {
            "kind": {
              "description": "Resource type as kubectl spells it: pods, deploy, Deployment, a CRD's name. Required unless mark is given.",
              "type": "string"
            },
            "mark": {
              "description": "A kx mark (with or without the leading @) in place of kind, name and namespace. list_marks shows them.",
              "type": "string"
            },
            "name": {
              "description": "Resource name. Required unless mark is given.",
              "type": "string"
            },
            "namespace": {
              "description": "Namespace; defaults to the kubeconfig's current namespace. Omit for cluster-scoped kinds such as nodes.",
              "type": "string"
            }
          },
          "type": [
            "null",
            "object"
          ]
        }
      },
      "type": "object"
    },
    "outputSchema": {
      "additionalProperties": false,
      "properties": {
        "context": {
