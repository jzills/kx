[
  {
    "name": "diagnose",
    "annotations": {
      "idempotentHint": true,
      "readOnlyHint": true,
      "title": "Diagnose"
    },
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "allNamespaces": {
          "description": "Sweep every namespace when there is no target.",
          "type": "boolean"
        },
        "full": {
          "description": "Include healthy resources in a sweep's results.",
          "type": "boolean"
        },
        "namespace": {
          "description": "Namespace to sweep when there is no target; defaults to the current namespace.",
          "type": "string"
        },
        "since": {
          "description": "Ignore what finished longer ago than this — 30m, 24h, 7d. Ongoing problems are always reported. Defaults to kx's diag_max_age setting.",
          "type": "string"
